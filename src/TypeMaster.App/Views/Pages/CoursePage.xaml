<UserControl x:Class="TypeMaster.App.Views.Pages.CoursePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:TypeMaster.App.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- 星级显示：把 0~5 星渲染成实心/空心星 -->
        <Style x:Key="StarTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFF6A623"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：进度总览 -->
        <materialDesign:Card Grid.Row="0" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="School" Width="22" Height="22" VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="课程中心" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource GlassPill}" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MedalOutline" Width="16" Height="16"
                                                    VerticalAlignment="Center" Foreground="#FF1976D2"/>
                            <TextBlock Text="{Binding RankText}" FontWeight="SemiBold" Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ProgressText}" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"
                               Foreground="#FFF6A623">
                        <Run Text="★"/>
                        <Run Text="{Binding TotalStars, Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding MaxStars, Mode=OneWay}"/>
                    </TextBlock>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="16,0,0,0" FontSize="12"
                            Content="重新开始闯关" Command="{Binding ResetProgressCommand}"
                            ToolTip="清空闯关进度，从第一关重新开始"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="6,0,0,0" FontSize="12"
                            Content="刷新" Command="{Binding RefreshCommand}"/>
                </StackPanel>

                <ProgressBar Value="{Binding OverallProgress}" Height="6" Margin="0,10,0,6"
                             Style="{StaticResource MaterialDesignLinearProgressBar}"/>

                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" TextWrapping="Wrap"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}" Margin="0,2,0,0">
                    <Run Text="通关标准："/>
                    <Run Text="{Binding PassRuleText, Mode=OneWay}"/>
                    <Run Text="　达标后自动解锁下一关"/>
                </TextBlock>
            </StackPanel>
        </materialDesign:Card>

        <!-- 主体：左关卡列表 / 右详情 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Padding="6">
                <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <!-- 阶段标题 -->
                                    <StackPanel Orientation="Horizontal" Margin="8,6,0,4">
                                        <materialDesign:PackIcon Kind="FlagVariantOutline" Width="16" Height="16"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        <TextBlock Text="{Binding StageName}" FontWeight="Bold" FontSize="14"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StageDescription}" FontSize="11" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- 该阶段的关卡 -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="4,3" Padding="10,8" CornerRadius="10"
                                                        BorderThickness="1"
                                                        Background="{DynamicResource GlassSurfaceBrush}"
                                                        BorderBrush="{DynamicResource GlassDividerBrush}"
                                                        MouseLeftButtonDown="Lesson_Click"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding LockHint}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 序号 / 锁 -->
                                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                                                Background="{DynamicResource GlassSurfaceStrongBrush}">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Index}" FontWeight="Bold" FontSize="12"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}"/>
                                                                <materialDesign:PackIcon Kind="Lock" Width="14" Height="14"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        Foreground="#FF9E9E9E"
                                                                                        Visibility="{Binding IsUnlocked, Converter={StaticResource InvBoolToVis}}"/>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                                                <Border Style="{StaticResource GlassPill}" Margin="8,0,0,0"
                                                                        Padding="8,1">
                                                                    <TextBlock Text="{Binding TypeText}" FontSize="10"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding LevelText}" FontSize="10" Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,3,0,0"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding StarsText}" Style="{StaticResource StarTextStyle}"
                                                                       HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding StateText}" FontSize="10"
                                                                       HorizontalAlignment="Right" Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </materialDesign:Card>

            <!-- 右侧详情与开始挑战 -->
            <materialDesign:Card Grid.Column="1" Width="300" Padding="14" Margin="10,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="关卡详情" FontWeight="Bold" FontSize="14" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedDetail}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                               Foreground="{DynamicResource GlassTextSecondaryBrush}" LineHeight="20"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,16,0,0" Height="38"
                            Content="开始挑战本关" Command="{Binding StartLessonCommand}"
                            IsEnabled="{Binding CanStart}"/>

                    <TextBlock Text="挑战时练习页会锁定本关的类型与难度等级，成绩达标即自动解锁下一关。"
                               TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                               Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>