<UserControl x:Class="TypeMaster.App.Views.Pages.TypingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:core="clr-namespace:TypeMaster.Core.Enums;assembly=TypeMaster.Core"
             xmlns:uc="clr-namespace:TypeMaster.App.Views.UserControls"
             xmlns:conv="clr-namespace:TypeMaster.App.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 关卡条（仅关卡模式显示） -->
                <RowDefinition Height="Auto"/>  <!-- 类型 / 难度选择 -->
                <RowDefinition Height="Auto"/>  <!-- 对照文本 + 输入区 -->
                <RowDefinition Height="Auto"/>  <!-- 实时统计 -->
                <RowDefinition Height="Auto"/>  <!-- 虚拟键盘 + 操作 -->
            </Grid.RowDefinitions>

            <!-- 关卡模式提示条 -->
            <materialDesign:Card Grid.Row="0" Padding="10" Margin="0,0,0,8"
                                 Visibility="{Binding IsLessonMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="School" Width="18" Height="18" VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="课程关卡：" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Text="{Binding LessonTitle}" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LessonRuleText}" FontSize="11" Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="12,0,0,0" FontSize="12"
                                Content="退出关卡" Command="{Binding ExitLessonCommand}"
                                ToolTip="回到自由练习模式"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LessonResultText}" FontSize="12" Margin="0,6,0,0"
                               FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 类型 / 难度选择 + 状态 -->
            <materialDesign:Card Grid.Row="1" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="练习类型：" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                        <Button Style="{StaticResource TypeSelectorStyle}" Margin="2" Content="英文" Tag="{x:Static core:PracticeType.English}"
                                Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static core:PracticeType.English}" FontSize="13"/>
                        <Button Style="{StaticResource TypeSelectorStyle}" Margin="2" Content="中文" Tag="{x:Static core:PracticeType.Chinese}"
                                Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static core:PracticeType.Chinese}" FontSize="13"/>
                        <Button Style="{StaticResource TypeSelectorStyle}" Margin="2" Content="英文单词" Tag="{x:Static core:PracticeType.EnglishWord}"
                                Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static core:PracticeType.EnglishWord}" FontSize="13"/>
                        <Button Style="{StaticResource TypeSelectorStyle}" Margin="2" Content="中文词组" Tag="{x:Static core:PracticeType.ChineseWord}"
                                Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static core:PracticeType.ChineseWord}" FontSize="13"/>
                        <Button Style="{StaticResource TypeSelectorStyle}" Margin="2" Content="五笔" Tag="{x:Static core:PracticeType.Wubi}"
                                Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static core:PracticeType.Wubi}" FontSize="13"/>
                        <Button Style="{StaticResource TypeSelectorStyle}" Margin="2" Content="限时测速" Tag="{x:Static core:PracticeType.SpeedTest}"
                                Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static core:PracticeType.SpeedTest}" FontSize="13"/>

                        <TextBlock Text="难度：" VerticalAlignment="Center" Margin="20,0,8,0" FontSize="13"/>
                        <Button Style="{StaticResource DifficultySelectorStyle}" Margin="2" Content="入门" Tag="{x:Static core:Difficulty.Entry}"
                                Command="{Binding SelectDifficultyCommand}" CommandParameter="{x:Static core:Difficulty.Entry}" FontSize="13"
                                ToolTip="面向刚接触键盘的初学者（小学生 / 长辈）：文本更短、节奏更慢、更容易达标"/>
                        <Button Style="{StaticResource DifficultySelectorStyle}" Margin="2" Content="简单" Tag="{x:Static core:Difficulty.Easy}"
                                Command="{Binding SelectDifficultyCommand}" CommandParameter="{x:Static core:Difficulty.Easy}" FontSize="13"/>
                        <Button Style="{StaticResource DifficultySelectorStyle}" Margin="2" Content="普通" Tag="{x:Static core:Difficulty.Normal}"
                                Command="{Binding SelectDifficultyCommand}" CommandParameter="{x:Static core:Difficulty.Normal}" FontSize="13"/>
                        <Button Style="{StaticResource DifficultySelectorStyle}" Margin="2" Content="困难" Tag="{x:Static core:Difficulty.Hard}"
                                Command="{Binding SelectDifficultyCommand}" CommandParameter="{x:Static core:Difficulty.Hard}" FontSize="13"/>

                        <!-- 难度细分折叠按钮：
                             改前只有一个 28×28 的箭头图标，用户看不出是干什么的。
                             现在做成带文字的胶囊，并把当前档位与级数写在按钮上，
                             收起状态下也能一眼看到"当前是几级"。 -->
                        <ToggleButton x:Name="DifficultyExpander" Margin="10,0,0,0"
                                      Padding="10,4" MinWidth="0" VerticalAlignment="Center"
                                      Cursor="Hand"
                                      Background="Transparent"
                                      BorderBrush="{DynamicResource GlassDividerBrush}"
                                      BorderThickness="1"
                                      ToolTip="点击展开更细的难度级别（共 13 级）；也可不展开，直接用左边的四个档位按钮">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="14"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon x:Name="Chev" Kind="ChevronDown"
                                                                     Width="16" Height="16"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                                            <TextBlock x:Name="Txt" Margin="5,0,0,0" FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                                       Text="级别细分"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 展开时：箭头翻转、文字改为"收起"、底色加重，状态一眼可辨 -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chev" Property="Kind" Value="ChevronUp"/>
                                            <Setter TargetName="Txt" Property="Text" Value="收起细分"/>
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource GlassSurfaceStrongBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource GlassSurfaceStrongBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </StackPanel>

                    <!-- 难度细分：1~13 级滑动条，与上方四档按钮双向联动（折叠展开） -->
                    <Border Margin="0,8,0,2" Padding="10,8" CornerRadius="10"
                            Background="{DynamicResource GlassSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource GlassDividerBrush}" BorderThickness="1"
                            Visibility="{Binding IsChecked, ElementName=DifficultyExpander, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="难度细分：" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0"/>
                            <Slider x:Name="DifficultySlider" Width="220" Minimum="1" Maximum="13"
                                    TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                    VerticalAlignment="Center" SmallChange="1" LargeChange="1"
                                    Value="{Binding DifficultyLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MaterialDesignDiscreteSlider}"/>
                            <TextBlock Text="{Binding DifficultyLevelText}" VerticalAlignment="Center" FontSize="13"
                                       FontWeight="SemiBold" Margin="16,0,0,0"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="{Binding BaselineSpeedText}" VerticalAlignment="Center" FontSize="11"
                                       Margin="14,0,0,0"
                                       Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 限时测速时长选择（仅测速模式显示） -->
                    <Border Margin="0,8,0,2" Padding="10,8" CornerRadius="10"
                            Background="{DynamicResource GlassSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource GlassDividerBrush}" BorderThickness="1"
                            Visibility="{Binding IsSpeedTestMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="TimerSand" Width="16" Height="16" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="测速时长：" VerticalAlignment="Center" FontSize="13" Margin="6,0,10,0"/>
                            <ComboBox Width="110" FontSize="12" VerticalAlignment="Center"
                                      ItemsSource="{Binding DurationOptions}" DisplayMemberPath="Name"
                                      SelectedValuePath="Minutes"
                                      SelectedValue="{Binding SelectedDurationMinutes, Mode=TwoWay}"/>
                            <TextBlock Text="时间到会自动结算并存档，中途也可手动提交" FontSize="11" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                        <materialDesign:PackIcon Kind="FileDocument" Width="16" Height="16"
                                                VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="练习文章：" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                        <ComboBox x:Name="ArticleCombo" MinWidth="180" Margin="0,0,8,0" FontSize="13"
                                  ItemsSource="{Binding Articles}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Margin="2" Content="导入文章" FontSize="12"
                                Click="OpenImport"/>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="2" Content="删除文章" FontSize="12"
                                Click="DeleteArticle" IsEnabled="{Binding CanDeleteSelected}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource PrimaryHueMidBrush}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 对照文本（彩色） + 五笔学习提示 + 输入区 -->
            <materialDesign:Card Grid.Row="2" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ===== 五笔学习提示区（仅五笔模式显示）=====
                         面向初学五笔的中老年用户：
                           · 大字显示当前要打的字与它的编码，不用眯眼
                           · 逐码告诉"第几码按哪个键、这个键叫什么"，不必先背熟字根
                           · 显示已打几码 / 共几码，心里有数
                    -->
                    <Border Grid.Row="0" x:Name="WubiHintPanel" Margin="0,0,0,8" Padding="12,10"
                            CornerRadius="8" Background="#FFF7E8" BorderBrush="#F0D9A8" BorderThickness="1"
                            Visibility="{Binding IsWubiMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- 大字：当前字 + 编码 -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowWubiBigChar, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Name="WubiBigCharText" Text="{Binding WubiBigText}"
                                           FontSize="34" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="#8A5A00"/>
                                <TextBlock x:Name="WubiProgressText" Margin="16,0,0,0" VerticalAlignment="Bottom"
                                           FontSize="13" Foreground="#A97B2E"
                                           Text="{Binding WubiTypedCodes, StringFormat=已打 {0} 码}"/>
                                <TextBlock Margin="4,0,0,0" VerticalAlignment="Bottom"
                                           FontSize="13" Foreground="#A97B2E"
                                           Text="{Binding WubiTotalCodes, StringFormat=/ 共 {0} 码}"/>
                            </StackPanel>

                            <!-- 逐码按键提示 -->
                            <TextBlock x:Name="WubiHintText" Margin="0,6,0,0" Text="{Binding WubiHintText}"
                                       FontSize="15" TextWrapping="Wrap" LineHeight="1.6"
                                       Foreground="#7A5200"
                                       Visibility="{Binding ShowWubiKeyHint, Converter={StaticResource BoolToVis}}"/>

                            <!-- 操作提示语 -->
                            <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#A97B2E"
                                       Text="按上面提示的顺序逐个按字母键即可；每个字打完按一下空格。想复习字根可到「学习园地」听口诀。"/>
                        </StackPanel>
                    </Border>

                    <RichTextBox x:Name="DisplayBox" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="False"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                 MinHeight="60" MaxHeight="260" FontSize="14">
                        <FlowDocument/>
                    </RichTextBox>

                    <TextBox x:Name="InputBox" Grid.Row="2" Margin="0,8,0,0" Padding="8,6"
                             BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="2"
                             TextWrapping="Wrap" AcceptsReturn="False"
                             MinHeight="36" MaxHeight="64"
                             FontSize="14"
                             Text="{Binding TypedText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             materialDesign:HintAssist.Hint="在此输入上方对照文本（支持中文输入法）"/>
                </Grid>
            </materialDesign:Card>

            <!-- 实时统计 -->
            <materialDesign:Card Grid.Row="3" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="正确" FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RightCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="错误" FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding WrongCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="正确率" FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding AccuracyText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="速度 WPM/KPM" FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SpeedText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock Text="耗时" FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TimeText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 限时测速：剩余时间；其它模式显示本次评级 -->
                        <StackPanel Grid.Column="5" HorizontalAlignment="Center"
                                    Visibility="{Binding IsSpeedTestMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="剩余时间" FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RemainingText}" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="#FFEF634B"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6" HorizontalAlignment="Center"
                                    Visibility="{Binding IsSpeedTestMode, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="本次评级" FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding GradeText}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding GradeChineseText}" FontSize="11" Margin="4,6,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ProgressBar Value="{Binding Progress}" Height="6" Margin="0,8,0,0"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 虚拟键盘 + 操作 -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <uc:VirtualKeyboard x:Name="VkHost" Grid.Column="0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Margin="3" Content="重置" FontSize="12"
                            Command="{Binding ResetCommand}" Click="RefocusInput"/>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="3" Content="换一篇" FontSize="12"
                            Command="{Binding LoadTextCommand}" Click="RefocusInput"/>
                    <Button Style="{StaticResource MaterialDesignRaisedDarkButton}" Margin="3" Content="提交成绩" FontSize="12"
                            Command="{Binding SubmitCommand}" Click="RefocusInput"/>
                </StackPanel>
            </Grid>

            <!-- 特效层（彩屑）与趣味提示气泡（置顶，不拦截操作） -->
            <Canvas x:Name="FxCanvas" IsHitTestVisible="False" Panel.ZIndex="50"/>
        </Grid>
    </ScrollViewer>
</UserControl>