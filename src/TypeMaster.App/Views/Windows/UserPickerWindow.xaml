<Window x:Class="TypeMaster.App.Views.Windows.UserPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:glass="clr-namespace:TypeMaster.App"
        xmlns:uc="clr-namespace:TypeMaster.App.Views.UserControls"
        Title="选择使用者" Height="520" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        glass:GlassWindowBehavior.Enable="True"
        FontFamily="{DynamicResource AppFontFamily}"
        glass:DialogSizingBehavior.ConstrainToWorkArea="True">
    <Window.Resources>
        <!-- 页面级转换器：与其它对话框/页面各自声明的做法一致（项目未在 App.xaml 全局注册） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- 玻璃窗体主体：圆角 + 半透明渐变 + 高光描边（与其它对话框一致） -->
    <Border CornerRadius="14" Background="{DynamicResource GlassWindowBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- 玻璃标题栏 -->
                <RowDefinition Height="*"/>    <!-- 内容 -->
            </Grid.RowDefinitions>

            <uc:GlassTitleBar Grid.Row="0" Title="选择使用者" IconKind="AccountMultiple"/>

            <materialDesign:Card Grid.Row="1" Margin="18" Padding="20"
                                 Background="{DynamicResource GlassSurfaceStrongBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 说明 -->
                        <RowDefinition Height="*"/>      <!-- 用户列表 -->
                        <RowDefinition Height="Auto"/>   <!-- 新建 -->
                        <RowDefinition Height="Auto"/>   <!-- 按钮 -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="这台电脑上有多个使用者" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource GlassTextBrush}"/>
                        <TextBlock Text="选择你自己的名字，成绩和闯关进度都记录在各自名下，互不影响。"
                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- 用户列表：点击某项即选中 -->
                    <ListBox x:Name="UserList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="UserList_SelectionChanged"
                             MouseDoubleClick="UserList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Nickname}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GlassTextBrush}"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- 当前正在使用的用户加一个标记 -->
                                    <materialDesign:PackIcon Grid.Column="1" Kind="CheckCircle"
                                                             Width="20" Height="20" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 新建使用者 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox x:Name="NewNameBox" Width="240" Padding="12,8,8,8"
                                 materialDesign:HintAssist.Hint="新使用者昵称"
                                 MaxLength="12" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="新建"
                                Margin="10,0,0,0" Width="96" Click="Create_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="0,0,14,0"
                                   FontSize="12" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                        <Button x:Name="OkButton" Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="就用这个" Width="130" Click="Ok_Click"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Border>
</Window>
