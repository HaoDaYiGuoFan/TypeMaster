<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    项目级 NuGet 源配置。

    为什么限定为 nuget.org：本机注册了一个私有源（QM，http://16t42p0590.imwork.net），
    该源离线时 dotnet build 会对每个项目产生 NU1900 警告（获取包漏洞数据失败），
    破坏「0 警告」构建基线。本项目全部依赖（MDIX / CommunityToolkit / EF Core /
    NAudio / System.Speech）均发布在 nuget.org，clear 后行为不变、构建可复现。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
