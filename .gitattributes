# ============================================================
#  换行符规范
#
#  本项目源码统一使用 LF（Unix 换行），这是既有约定。
#  显式在仓库层面固定，避免不同机器上的 core.autocrlf 设置
#  导致克隆后换行符被改写、进而产生无意义的整文件 diff。
# ============================================================

# 默认：检出时也保持 LF，不随平台转换
* text=auto eol=lf

# ------------------------------------------------------------
#  源码：强制 LF
# ------------------------------------------------------------
*.cs       text eol=lf
*.xaml     text eol=lf
*.csproj   text eol=lf
*.sln      text eol=lf
*.json     text eol=lf
*.config   text eol=lf
*.props    text eol=lf
*.targets  text eol=lf

# ------------------------------------------------------------
#  文档：强制 LF
# ------------------------------------------------------------
*.md       text eol=lf
*.txt      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# ------------------------------------------------------------
#  脚本：强制 LF（避免在 Linux/CI 上因 CRLF 无法执行）
# ------------------------------------------------------------
*.ps1      text eol=lf
*.sh       text eol=lf
*.py       text eol=lf

# ------------------------------------------------------------
#  Windows 批处理：必须 CRLF（否则可能无法运行）
# ------------------------------------------------------------
*.bat      text eol=crlf
*.cmd      text eol=crlf

# ------------------------------------------------------------
#  二进制资源：不做任何转换，且不参与文本 diff
# ------------------------------------------------------------
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.mp3      binary
*.wav      binary
*.dll      binary
*.exe      binary
*.zip      binary
*.db       binary
*.ttf      binary
*.otf      binary

# ------------------------------------------------------------
#  语言统计：标记为 vendored / 生成物，避免污染 GitHub 语言占比
# ------------------------------------------------------------
*.Designer.cs   linguist-generated=true
*.g.cs          linguist-generated=true
*.g.i.cs        linguist-generated=true
