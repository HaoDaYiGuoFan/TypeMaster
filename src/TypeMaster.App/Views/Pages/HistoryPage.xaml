<UserControl x:Class="TypeMaster.App.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:TypeMaster.App.Converters"
             xmlns:uc="clr-namespace:TypeMaster.App.Views.UserControls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:PracticeTypeToTextConverter x:Key="PracticeTypeConv"/>
        <conv:DifficultyToTextConverter x:Key="DifficultyConv"/>
        <conv:HeatLevelToBrushConverter x:Key="HeatBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:GradeToBrushConverter x:Key="GradeBrushConv"/>
        <conv:GradeIntToTextConverter x:Key="GradeIntConv"/>
        <conv:GradeIntToBrushConverter x:Key="GradeIntBrushConv"/>

        <!-- 概览卡片里的小标题 -->
        <Style x:Key="MetricCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 筛选与操作 -->
                <RowDefinition Height="Auto"/>  <!-- 概览卡片 -->
                <RowDefinition Height="Auto"/>  <!-- 趋势曲线 -->
                <RowDefinition Height="Auto"/>  <!-- 分类汇总 -->
                <RowDefinition Height="Auto"/>  <!-- 弱点与热力图 -->
                <RowDefinition Height="Auto"/>  <!-- 明细表 -->
            </Grid.RowDefinitions>

            <!-- 筛选与操作 -->
            <materialDesign:Card Grid.Row="0" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartLine" Width="20" Height="20" VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="成绩统计" FontSize="16" FontWeight="SemiBold" Margin="8,0,16,0"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="类型：" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                        <ComboBox Width="120" FontSize="12" VerticalAlignment="Center"
                                  ItemsSource="{Binding TypeFilters}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}"/>

                        <TextBlock Text="时间：" VerticalAlignment="Center" FontSize="12" Margin="12,0,6,0"/>
                        <ComboBox Width="110" FontSize="12" VerticalAlignment="Center"
                                  ItemsSource="{Binding RangeFilters}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedRangeFilter, Mode=TwoWay}"/>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Margin="14,0,0,0" FontSize="12"
                                Content="加载成绩" Command="{Binding LoadCommand}"/>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="6,0,0,0" FontSize="12"
                                Content="导出 CSV" Command="{Binding ExportCommand}"
                                ToolTip="把当前筛选后的记录导出为 CSV 文件"/>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="6,0,0,0" FontSize="12"
                                Content="清空记录" Command="{Binding ClearCommand}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" FontSize="12"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 概览卡片 -->
            <materialDesign:Card Grid.Row="1" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="练习次数" Style="{StaticResource MetricCaption}"/>
                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="平均速度" Style="{StaticResource MetricCaption}"/>
                        <TextBlock Text="{Binding AvgSpeedText}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="最佳速度" Style="{StaticResource MetricCaption}"/>
                        <TextBlock Text="{Binding BestSpeedText}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="平均正确率" Style="{StaticResource MetricCaption}"/>
                        <TextBlock Text="{Binding AvgAccuracyText}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="累计练习时长" Style="{StaticResource MetricCaption}"/>
                        <TextBlock Text="{Binding TotalTimeText}" Style="{StaticResource MetricValue}" FontSize="15"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5">
                        <TextBlock Text="当前段位" Style="{StaticResource MetricCaption}"/>
                        <TextBlock Text="{Binding RankText}" Style="{StaticResource MetricValue}"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="最近一次评级" Style="{StaticResource MetricCaption}"/>
                        <TextBlock Text="{Binding LatestGradeText}" Style="{StaticResource MetricValue}"
                                   Foreground="{Binding LatestGradeText, Converter={StaticResource GradeBrushConv}}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- 趋势曲线 -->
            <materialDesign:Card Grid.Row="2" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="TrendingUp" Width="17" Height="17" VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="进步曲线" FontWeight="SemiBold" FontSize="13" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="（蓝线=速度，绿虚线=正确率；点的颜色代表该次评级）" FontSize="11"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                    </StackPanel>

                    <uc:TrendChart Height="220" Points="{Binding Trend}"/>

                    <TextBlock Text="数据太少或不满足筛选条件时曲线为空，可切换到「全部时间」查看。" FontSize="11"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource GlassTextSecondaryBrush}"
                               Visibility="{Binding HasTrend, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 分类汇总 -->
            <materialDesign:Card Grid.Row="3" Padding="6" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,8,0,6">
                        <materialDesign:PackIcon Kind="TableLarge" Width="17" Height="17" VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="分类汇总" FontWeight="SemiBold" FontSize="13" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="（按练习类型统计，用于看哪一类练习投入最多、水平最高）" FontSize="11"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Summary}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" MaxHeight="200"
                              materialDesign:DataGridAssist.CellPadding="8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="练习类型" Binding="{Binding TypeName}" Width="120"/>
                            <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="70"/>
                            <DataGridTextColumn Header="平均速度" Binding="{Binding AvgSpeed}" Width="100"/>
                            <DataGridTextColumn Header="最佳速度" Binding="{Binding BestSpeed}" Width="100"/>
                            <DataGridTextColumn Header="速度单位" Binding="{Binding SpeedUnit}" Width="90"/>
                            <DataGridTextColumn Header="平均正确率(%)" Binding="{Binding AvgAccuracy, StringFormat=F1}" Width="120"/>
                            <DataGridTextColumn Header="最佳评级" Binding="{Binding BestGrade}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground"
                                                Value="{Binding BestGrade, Converter={StaticResource GradeBrushConv}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- 弱点分析与热力图 -->
            <materialDesign:Card Grid.Row="4" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="17" Height="17"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="弱点分析 · 键盘热力图" FontWeight="SemiBold" FontSize="13" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="（颜色越深表示该键错误越多；浅绿底为基准键）" FontSize="11"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding WeaknessSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 键盘热力图：按 QWERTY 排列，逐键着色 -->
                        <StackPanel Grid.Column="0">
                            <ItemsControl ItemsSource="{Binding HeatRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Keys}" Margin="0,2">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="42" Height="34" Margin="2" CornerRadius="6"
                                                            BorderThickness="1"
                                                            Background="{Binding HeatLevel, Converter={StaticResource HeatBrush}}"
                                                            BorderBrush="{DynamicResource GlassDividerBrush}"
                                                            ToolTip="{Binding Tooltip}">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Display}" FontSize="12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold"/>
                                                            <!-- 基准键标记：底部一条短横线，与虚拟键盘的提示一致 -->
                                                            <Rectangle Height="3" Width="14" RadiusX="1.5" RadiusY="1.5"
                                                                       Fill="#FF2E7D32" VerticalAlignment="Bottom"
                                                                       Margin="0,0,0,3"
                                                                       Visibility="{Binding IsHomeKey, Converter={StaticResource BoolToVis}}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="中文练习走输入法，不采集物理按键，因此热力图只统计英文 / 单词 / 五笔练习。"
                                       FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap" MaxWidth="580"
                                       Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- 薄弱键位排名 -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" MinWidth="300">
                            <TextBlock Text="最需要加强的按键" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding WeakKeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="8,5" CornerRadius="8"
                                                Background="{DynamicResource GlassSurfaceBrush}"
                                                ToolTip="{Binding Advice}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Rank}" FontWeight="Bold"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Width="30" Height="26" CornerRadius="5"
                                                        Background="{DynamicResource GlassSurfaceStrongBrush}">
                                                    <TextBlock Text="{Binding Display}" FontSize="12" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Margin="10,0,0,0" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap">
                                                    <Run Text="错误"/>
                                                    <Run Text="{Binding Wrong, Mode=OneWay}"/>
                                                    <Run Text="次 / 共"/>
                                                    <Run Text="{Binding Total, Mode=OneWay}"/>
                                                    <Run Text="次　错误率"/>
                                                    <Run Text="{Binding ErrorRate, Mode=OneWay, StringFormat=F1}"/>
                                                    <Run Text="%"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="样本少于 5 次的按键不参与排名，避免偶发错误造成误判。" FontSize="11"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- 成绩明细 -->
            <materialDesign:Card Grid.Row="5" Padding="6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,8,0,6">
                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="17" Height="17"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="成绩明细" FontWeight="SemiBold" FontSize="13" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True"
                              MaxHeight="320"
                              materialDesign:DataGridAssist.CellPadding="8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="记录时间" Binding="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding PracticeType, Converter={StaticResource PracticeTypeConv}}" Width="90"/>
                            <DataGridTextColumn Header="难度" Binding="{Binding Difficulty, Converter={StaticResource DifficultyConv}}" Width="70"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding Level}" Width="60"/>
                            <DataGridTextColumn Header="评级" Binding="{Binding Grade, Converter={StaticResource GradeIntConv}}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground"
                                                Value="{Binding Grade, Converter={StaticResource GradeIntBrushConv}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="总字符" Binding="{Binding TotalCharCount}" Width="80"/>
                            <DataGridTextColumn Header="正确" Binding="{Binding RightCharCount}" Width="70"/>
                            <DataGridTextColumn Header="错误" Binding="{Binding WrongCharCount}" Width="70"/>
                            <DataGridTextColumn Header="速度" Binding="{Binding Speed}" Width="80"/>
                            <DataGridTextColumn Header="正确率(%)" Binding="{Binding Accuracy, StringFormat=F1}" Width="95"/>
                            <DataGridTextColumn Header="耗时(秒)" Binding="{Binding UseSecond}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>