<Window x:Class="TypeMaster.App.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:glass="clr-namespace:TypeMaster.App"
        xmlns:local="clr-namespace:TypeMaster.App.Views.Windows"
        xmlns:ui="clr-namespace:TypeMaster.App"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="720" Width="1100" MinHeight="560" MinWidth="760"
        Icon="pack://application:,,,/TypeMaster;component/AppIcon.ico"
        ResizeMode="CanResize"
        FontFamily="{DynamicResource AppFontFamily}"
        glass:GlassWindowBehavior.Enable="True"
        StateChanged="MainWindow_StateChanged"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 顶栏导航按钮：选中态由 ViewModel 的选中标志驱动 -->
        <Style x:Key="NavHomeButton" TargetType="Button" BasedOn="{StaticResource GlassNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHomeSelected}" Value="True">
                    <Setter Property="Background" Value="#CCFFFFFF"/>
                    <Setter Property="Foreground" Value="#FF1976D2"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavTypingButton" TargetType="Button" BasedOn="{StaticResource GlassNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTypingSelected}" Value="True">
                    <Setter Property="Background" Value="#CCFFFFFF"/>
                    <Setter Property="Foreground" Value="#FF1976D2"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavHistoryButton" TargetType="Button" BasedOn="{StaticResource GlassNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHistorySelected}" Value="True">
                    <Setter Property="Background" Value="#CCFFFFFF"/>
                    <Setter Property="Foreground" Value="#FF1976D2"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavGameCenterButton" TargetType="Button" BasedOn="{StaticResource GlassNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGameCenterSelected}" Value="True">
                    <Setter Property="Background" Value="#CCFFFFFF"/>
                    <Setter Property="Foreground" Value="#FF1976D2"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavLearnButton" TargetType="Button" BasedOn="{StaticResource GlassNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLearnSelected}" Value="True">
                    <Setter Property="Background" Value="#CCFFFFFF"/>
                    <Setter Property="Foreground" Value="#FF1976D2"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavCourseButton" TargetType="Button" BasedOn="{StaticResource GlassNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCourseSelected}" Value="True">
                    <Setter Property="Background" Value="#CCFFFFFF"/>
                    <Setter Property="Foreground" Value="#FF1976D2"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 玻璃窗体主体：圆角 + 半透明渐变 + 高光描边 -->
    <Border x:Name="RootBorder" CornerRadius="14"
            ui:UiScaleBehavior.Scale="{Binding UiScale}"
            Background="{DynamicResource GlassWindowBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>   <!-- macOS 风格玻璃工具栏 -->
                <RowDefinition Height="*"/>    <!-- 内容区域 -->
            </Grid.RowDefinitions>

            <!-- ========== 顶部工具栏：玻璃质感 + 交通灯按钮 + 导航 ========== -->
            <Border Grid.Row="0" Background="{DynamicResource GlassTopBarBrush}"
                    BorderBrush="{DynamicResource GlassDividerBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>    <!-- 交通灯 + Logo -->
                        <ColumnDefinition Width="*"/>        <!-- 导航按钮区 -->
                        <ColumnDefinition Width="Auto"/>     <!-- 用户信息 -->
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：macOS 交通灯（带常显功能符号） + 应用图标 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,16,0">
                        <Button Style="{StaticResource MacWindowButton}" Background="#FF5F57"
                                Content="&#xE8BB;" ToolTip="关闭" Click="CloseWindow"/>
                        <Button Style="{StaticResource MacWindowButton}" Background="#FEBC2E"
                                Content="&#xE921;" ToolTip="最小化" Click="MinimizeWindow"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource MacWindowButton}" Background="#28C840"
                                Content="&#xE922;" ToolTip="最大化 / 还原" Click="MaximizeRestoreWindow"/>
                        <materialDesign:PackIcon Kind="KeyboardVariant" Width="22" Height="22"
                                                Foreground="#FF1976D2" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>

                    <!-- 中间：导航按钮（首页 / 打字练习 / 成绩统计 / 游戏乐园） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Button Style="{StaticResource NavHomeButton}" Command="{Binding GoHomeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Home" Width="17" Height="17"/>
                                <TextBlock Text="首页" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavTypingButton}" Command="{Binding GoTypingCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Typewriter" Width="17" Height="17"/>
                                <TextBlock Text="打字练习" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavHistoryButton}" Command="{Binding GoHistoryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartLine" Width="17" Height="17"/>
                                <TextBlock Text="成绩统计" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavGameCenterButton}" Command="{Binding GoGameCenterCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="GamepadVariant" Width="17" Height="17"/>
                                <TextBlock Text="游戏乐园" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavLearnButton}" Command="{Binding GoLearnCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="School" Width="17" Height="17"/>
                                <TextBlock Text="学习园地" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCourseButton}" Command="{Binding GoCourseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrophyVariantOutline" Width="17" Height="17"/>
                                <TextBlock Text="课程中心" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 右侧：用户昵称 + 修改入口 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Style="{StaticResource GlassPill}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountCircle" Width="20" Height="20"
                                                        Foreground="#FF1976D2" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Nickname}" Foreground="#D01B2733"
                                           FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" Padding="0"
                                Command="{Binding EditNicknameCommand, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                ToolTip="修改昵称" Foreground="#A61B2733">
                            <materialDesign:PackIcon Kind="Pencil" Width="17" Height="17"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区域：全宽玻璃容器 -->
            <ContentControl x:Name="ContentArea" Grid.Row="1" Margin="16" Focusable="False"/>
        </Grid>
    </Border>
</Window>
