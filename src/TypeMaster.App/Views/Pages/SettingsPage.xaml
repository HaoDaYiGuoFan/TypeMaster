<UserControl x:Class="TypeMaster.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
        <StackPanel>
        <materialDesign:Card Padding="18" Margin="4">
            <StackPanel Width="420">
                <TextBlock Text="系统设置" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"
                           Foreground="{DynamicResource GlassTextBrush}"/>

                <TextBlock Text="昵称（应用内这样称呼你）" Margin="0,0,0,4"
                           Foreground="{DynamicResource GlassTextBrush}"/>
                <TextBox Text="{Binding Nickname}" Width="220" HorizontalAlignment="Left"
                         materialDesign:HintAssist.Hint="留空则恢复默认昵称" MaxLength="12"/>

                <TextBlock Text="主题" Margin="0,6,0,4" Foreground="{DynamicResource GlassTextBrush}"/>
                <ComboBox SelectedValue="{Binding Config.Theme}" SelectedValuePath="Tag" Width="220" HorizontalAlignment="Left">
                    <ComboBoxItem Content="亮色" Tag="0"/>
                    <ComboBoxItem Content="护眼绿" Tag="1"/>
                    <ComboBoxItem Content="暗黑" Tag="2"/>
                </ComboBox>

                <TextBlock Text="打字区字体" Margin="0,14,0,4" Foreground="{DynamicResource GlassTextBrush}"/>
                <ComboBox SelectedValue="{Binding Config.FontFamily}" SelectedValuePath="Content" Width="220" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Consolas"/>
                    <ComboBoxItem Content="Microsoft YaHei"/>
                    <ComboBoxItem Content="SimSun"/>
                    <ComboBoxItem Content="KaiTi"/>
                </ComboBox>

                <TextBlock Text="{Binding Config.FontSize, StringFormat=字号：{0}}" Margin="0,14,0,4"
                           Foreground="{DynamicResource GlassTextBrush}"/>
                <Slider Value="{Binding Config.FontSize}" Minimum="14" Maximum="40" Width="320" HorizontalAlignment="Left"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"/>

                <TextBlock Text="{Binding Config.WindowWidth, StringFormat=窗口宽度：{0}}" Margin="0,14,0,4"
                           Foreground="{DynamicResource GlassTextBrush}"/>
                <Slider Value="{Binding Config.WindowWidth}" Minimum="900" Maximum="1600" Width="320" HorizontalAlignment="Left"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"/>

                <TextBlock Text="{Binding Config.WindowHeight, StringFormat=窗口高度：{0}}" Margin="0,14,0,4"
                           Foreground="{DynamicResource GlassTextBrush}"/>
                <Slider Value="{Binding Config.WindowHeight}" Minimum="600" Maximum="1000" Width="320" HorizontalAlignment="Left"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"/>

                <CheckBox Content="显示虚拟键盘" IsChecked="{Binding Config.ShowVirtualKeyboard}" Margin="0,16,0,6"/>
                <CheckBox Content="开启按键音效" IsChecked="{Binding Config.EnableSound}" Margin="0,6,0,6"/>
                <CheckBox Content="开启语音朗读（学习园地的口诀与拼音）" IsChecked="{Binding Config.EnableSpeech}" Margin="0,6,0,6"/>

                <TextBlock Text="{Binding Config.SpeechRate, StringFormat=朗读语速：{0}}" Margin="0,10,0,4"
                           Foreground="{DynamicResource GlassTextBrush}"/>
                <Slider Value="{Binding Config.SpeechRate}" Minimum="-5" Maximum="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Width="320" HorizontalAlignment="Left"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"/>
                <TextBlock Text="朗读使用 Windows 内置中文语音，全程离线，不联网、不上传任何内容。"
                           FontSize="11.5" TextWrapping="Wrap" Width="420" HorizontalAlignment="Left" Margin="0,4,0,0"
                           Foreground="{DynamicResource GlassTextSecondaryBrush}"/>

                <CheckBox Content="开启背景音乐（游戏乐园）" IsChecked="{Binding Config.EnableMusic}" Margin="0,16,0,6"/>

                <TextBlock Text="{Binding Config.MusicVolume, StringFormat=音乐音量：{0}}" Margin="0,10,0,4"
                           Foreground="{DynamicResource GlassTextBrush}"/>
                <Slider Value="{Binding Config.MusicVolume}" Minimum="0" Maximum="100" TickFrequency="5"
                        IsSnapToTickEnabled="True" Width="320" HorizontalAlignment="Left"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"/>

                <TextBlock Text="{Binding Config.SoundVolume, StringFormat=音效音量：{0}}" Margin="0,14,0,4"
                           Foreground="{DynamicResource GlassTextBrush}"/>
                <Slider Value="{Binding Config.SoundVolume}" Minimum="0" Maximum="100" TickFrequency="5"
                        IsSnapToTickEnabled="True" Width="320" HorizontalAlignment="Left"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"/>
                <TextBlock Text="背景音乐为随程序一起发布的原创循环曲，无需联网。"
                           FontSize="11.5" TextWrapping="Wrap" Width="420" HorizontalAlignment="Left" Margin="0,4,0,0"
                           Foreground="{DynamicResource GlassTextSecondaryBrush}"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Content="保存设置"
                        Command="{Binding SaveCommand}" Margin="0,16,0,0" Width="160" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Padding="18" Margin="4,12,4,4">
            <StackPanel Width="420">
                <TextBlock Text="关于 TypeMaster" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"
                           Foreground="{DynamicResource GlassTextBrush}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="AccountCircle" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,8,0"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="作者："/>
                        <Run Text="大表哥" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="Email" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,8,0"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="邮箱："/>
                        <Run Text="hutianyiit@gmail.com" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding AppVersionText}" FontWeight="SemiBold"
                           Foreground="{DynamicResource GlassTextBrush}" Margin="0,10,0,0"/>
                <TextBlock Text="© 2026 大表哥 · 保留所有权利"
                           Foreground="{DynamicResource GlassTextSecondaryBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="打字练习机 — 零基础入门，轻松学打字的练字小工具"
                           Foreground="{DynamicResource GlassTextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
