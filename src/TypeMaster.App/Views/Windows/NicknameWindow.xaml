<Window x:Class="TypeMaster.App.Views.Windows.NicknameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:glass="clr-namespace:TypeMaster.App"
        xmlns:uc="clr-namespace:TypeMaster.App.Views.UserControls"
        Title="设置昵称" Height="430" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        glass:GlassWindowBehavior.Enable="True"
        FontFamily="{DynamicResource AppFontFamily}"
        glass:DialogSizingBehavior.ConstrainToWorkArea="True">
    <!-- 玻璃窗体主体：圆角 + 半透明渐变 + 高光描边 -->
    <Border CornerRadius="14" Background="{DynamicResource GlassWindowBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- 玻璃标题栏 -->
                <RowDefinition Height="*"/>    <!-- 内容 -->
            </Grid.RowDefinitions>

            <uc:GlassTitleBar Grid.Row="0" Title="设置昵称" IconKind="AccountCircle"/>

            <materialDesign:Card Grid.Row="1" Margin="20" Padding="28"
                                 Background="{DynamicResource GlassSurfaceStrongBrush}">
                <StackPanel>
                    <TextBlock Text="嗨～先给自己起个名字吧！" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,10"
                               Foreground="{DynamicResource GlassTextBrush}"/>

                    <TextBlock Text="以后就用这个名字称呼你哦" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,0,0,20"
                               Foreground="{DynamicResource GlassTextSecondaryBrush}"/>

                    <TextBox x:Name="NameBox" materialDesign:HintAssist.Hint="输入你的昵称（可留空）"
                             Width="320" HorizontalAlignment="Center" FontSize="16"
                             MaxLength="12" Padding="14,8,8,8"
                             TextChanged="NameBox_TextChanged"/>

                    <TextBlock x:Name="HintText" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,14,0,24"
                               Foreground="{DynamicResource GlassTextSecondaryBrush}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="OkButton" Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="开始吧" Width="130" Click="Ok"/>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="以后再说" Width="130" Margin="16,0,0,0" Click="Cancel"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Border>
</Window>
