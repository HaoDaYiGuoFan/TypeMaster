<UserControl x:Class="TypeMaster.App.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- 功能卡片样式：玻璃圆角卡片 + 阴影 + 悬停微动效 -->
        <Style x:Key="FeatureCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GlassSurfaceStrongBrush}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-3" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                 To="10" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                 To="3" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 卡片图标圆容器 -->
        <Style x:Key="IconCircle" TargetType="Border">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 底部快捷按钮样式 -->
        <Style x:Key="QuickNavButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </UserControl.Resources>

    <!-- 根层 ScrollViewer：确保任何分辨率/DPI 缩放下内容都可滚动访问 -->
    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 欢迎横幅 -->
                <RowDefinition Height="Auto"/>   <!-- 功能卡片区 -->
                <RowDefinition Height="Auto"/>   <!-- 底部快捷栏 -->
            </Grid.RowDefinitions>

            <!-- ========== 欢迎横幅：玻璃卡片 + 蓝色柔光点缀 ========== -->
            <Border Grid.Row="0" Margin="0,0,0,16" CornerRadius="18" ClipToBounds="True"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                <Grid>
                    <!-- 深蓝主题色铺底：保证白色标题与副标题有足够对比度，同时保留玻璃通透感 -->
                    <Border CornerRadius="18" Opacity="0.95">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F20D47A1" Offset="0"/>
                                <GradientStop Color="#F21565C0" Offset="0.55"/>
                                <GradientStop Color="#F21976D2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="28,24,28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：欢迎语（白字深底，对比度优先） -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="欢迎使用" FontSize="24" FontWeight="Bold" Foreground="White">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.35" Color="#0D47A1"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="零基础入门，轻松学打字，在玩乐中提升速度与准确率"
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="White"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- 右侧：装饰键盘图案（玻璃质感） -->
                        <Border Grid.Column="1" CornerRadius="14" Padding="16,12"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="1">
                                    <Rectangle Width="14" Height="10" RadiusX="2" RadiusY="2" Fill="#BBDEFB" Margin="1.5"/>
                                    <Rectangle Width="14" Height="10" RadiusX="2" RadiusY="2" Fill="#90CAF9" Margin="1.5"/>
                                    <Rectangle Width="14" Height="10" RadiusX="2" RadiusY="2" Fill="#64B5F6" Margin="1.5"/>
                                    <Rectangle Width="14" Height="10" RadiusX="2" RadiusY="2" Fill="#42A5F5" Margin="1.5"/>
                                    <Rectangle Width="14" Height="10" RadiusX="2" RadiusY="2" Fill="#2196F3" Margin="1.5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="1">
                                    <Rectangle Width="14" Height="10" RadiusX="2" RadiusY="2" Fill="#1E88E5" Margin="1.5"/>
                                    <Rectangle Width="14" Height="10" RadiusX="2" RadiusY="2" Fill="#1976D2" Margin="1.5"/>
                                    <Rectangle Width="14" Height="10" RadiusX="2" RadiusY="2" Fill="#1565C0" Margin="1.5"/>
                                    <Rectangle Width="14" Height="10" RadiusX="2" RadiusY="2" Fill="#0D47A1" Margin="1.5"/>
                                    <Rectangle Width="44" Height="10" RadiusX="2" RadiusY="2" Fill="#0D47A1" Margin="1.5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="1">
                                    <Rectangle Width="20" Height="10" RadiusX="2" RadiusY="2" Fill="#BBDEFB" Margin="1.5"/>
                                    <Rectangle Width="20" Height="10" RadiusX="2" RadiusY="2" Fill="#90CAF9" Margin="1.5"/>
                                    <Rectangle Width="20" Height="10" RadiusX="2" RadiusY="2" Fill="#64B5F6" Margin="1.5"/>
                                    <Rectangle Width="20" Height="10" RadiusX="2" RadiusY="2" Fill="#42A5F5" Margin="1.5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========== 功能卡片区：4 张玻璃卡片（WrapPanel 自适应换行） ========== -->
            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <!-- 打字练习 -->
                <Border Style="{StaticResource FeatureCard}" Margin="8" Width="220"
                        MouseLeftButtonDown="CardClick_Typing">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.10" Color="#1565C0"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Style="{StaticResource IconCircle}" Background="#C7E3F8">
                            <materialDesign:PackIcon Kind="Typewriter" Width="26" Height="26"
                                                    Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="打字练习" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"
                                   Foreground="{DynamicResource GlassTextBrush}"/>
                        <TextBlock Text="英文 / 中文 / 限时测速 / 五笔字根，15 级难度细分（入门到地狱五档，适合小学生到熟练用户），实时统计正确率与速度"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 学习园地 -->
                <Border Style="{StaticResource FeatureCard}" Margin="8" Width="220"
                        MouseLeftButtonDown="CardClick_Learn">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.10" Color="#00695C"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Style="{StaticResource IconCircle}" Background="#B2DFDB">
                            <materialDesign:PackIcon Kind="School" Width="26" Height="26"
                                                    Foreground="#00695C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="学习园地" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"
                                   Foreground="{DynamicResource GlassTextBrush}"/>
                        <TextBlock Text="五笔字根表与助记口诀、拼音声韵母与拼读规则、标准打字指法详解"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 课程中心：渐进式闯关路线 -->
                <Border Style="{StaticResource FeatureCard}" Margin="8" Width="220"
                        MouseLeftButtonDown="CardClick_Course">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.10" Color="#C62828"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Style="{StaticResource IconCircle}" Background="#FFCDD2">
                            <materialDesign:PackIcon Kind="TrophyVariantOutline" Width="26" Height="26"
                                                    Foreground="#C62828" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="课程中心" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"
                                   Foreground="{DynamicResource GlassTextBrush}"/>
                        <TextBlock Text="指法入门 → 单键 → 单词 → 句子 → 文章，21 关渐进闯关，达标解锁下一关"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- 成绩统计 -->
                <Border Style="{StaticResource FeatureCard}" Margin="8" Width="220"
                        MouseLeftButtonDown="CardClick_History">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.10" Color="#2E7D32"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Style="{StaticResource IconCircle}" Background="#C8E6C9">
                            <materialDesign:PackIcon Kind="ChartLine" Width="26" Height="26"
                                                    Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="成绩统计" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"
                                   Foreground="{DynamicResource GlassTextBrush}"/>
                        <TextBlock Text="查看历史成绩、进步曲线，分析打字弱点，追踪成长轨迹"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 游戏乐园 -->
                <Border Style="{StaticResource FeatureCard}" Margin="8" Width="220"
                        MouseLeftButtonDown="CardClick_GameCenter">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.10" Color="#EF6C00"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Style="{StaticResource IconCircle}" Background="#FFE0B2">
                            <materialDesign:PackIcon Kind="GamepadVariant" Width="26" Height="26"
                                                    Foreground="#EF6C00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="游戏乐园" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"
                                   Foreground="{DynamicResource GlassTextBrush}"/>
                        <TextBlock Text="太空大战 / 打地鼠 / 抓小偷 / 青蛙吃虫，边玩边练"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 系统设置 -->
                <Border Style="{StaticResource FeatureCard}" Margin="8" Width="220"
                        MouseLeftButtonDown="CardClick_Settings">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.10" Color="#7B1FA2"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Style="{StaticResource IconCircle}" Background="#E1BEE7">
                            <materialDesign:PackIcon Kind="CogOutline" Width="26" Height="26"
                                                    Foreground="#7B1FA2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="系统设置" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"
                                   Foreground="{DynamicResource GlassTextBrush}"/>
                        <TextBlock Text="修改昵称、开关音效、切换主题、管理自定义文章"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ========== 底部快捷栏：从这里开始 + 快捷入口 ========== -->
            <Border Grid.Row="2" Style="{StaticResource GlassPanel}" CornerRadius="14,14,14,14" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：从这里开始提示 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ArrowDownBoldCircle" Width="18" Height="18"
                                                Foreground="#1976D2" VerticalAlignment="Center"/>
                        <TextBlock Text="从这里开始" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1976D2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 右侧：快捷入口按钮组 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource QuickNavButton}" Command="{Binding GoTypingCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Keyboard" Width="16" Height="16" Foreground="#1565C0"/>
                                <TextBlock Text="打字测试" Margin="4,0,0,0" Foreground="#1565C0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickNavButton}" Command="{Binding GoHistoryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrendingUp" Width="16" Height="16" Foreground="#2E7D32"/>
                                <TextBlock Text="进步曲线" Margin="4,0,0,0" Foreground="#2E7D32"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickNavButton}" Command="{Binding GoGameCenterCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ControllerClassic" Width="16" Height="16" Foreground="#EF6C00"/>
                                <TextBlock Text="打字游戏" Margin="4,0,0,0" Foreground="#EF6C00"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickNavButton}" Command="{Binding GoLearnCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="School" Width="16" Height="16" Foreground="#00695C"/>
                                <TextBlock Text="学习园地" Margin="4,0,0,0" Foreground="#00695C"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickNavButton}" Command="{Binding GoSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" Foreground="#7B1FA2"/>
                                <TextBlock Text="系统设置" Margin="4,0,0,0" Foreground="#7B1FA2"/>
                            </StackPanel>
                        </Button>
                        <!-- 新手入门操作指引：随时可重新打开首次启动时的引导窗口 -->
                        <Button Style="{StaticResource QuickNavButton}" Click="ShowGuide"
                                ToolTip="打开新手入门操作指引，快速了解打字练习、游戏乐园与各项功能">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16" Foreground="#C62828"/>
                                <TextBlock Text="新手指引" Margin="4,0,0,0" Foreground="#C62828"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
