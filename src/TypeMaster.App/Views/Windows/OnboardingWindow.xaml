<Window x:Class="TypeMaster.App.Views.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:glass="clr-namespace:TypeMaster.App"
        xmlns:uc="clr-namespace:TypeMaster.App.Views.UserControls"
        mc:Ignorable="d"
        Title="新手引导" Height="580" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        glass:GlassWindowBehavior.Enable="True"
        FontFamily="{DynamicResource AppFontFamily}">
    <!-- 玻璃窗体主体：圆角 + 半透明渐变 + 高光描边 -->
    <Border CornerRadius="14" Background="{DynamicResource GlassWindowBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- 玻璃标题栏 -->
                <RowDefinition Height="*"/>    <!-- 内容 -->
            </Grid.RowDefinitions>

            <uc:GlassTitleBar Grid.Row="0" Title="新手引导" IconKind="SchoolOutline"/>

            <materialDesign:Card Grid.Row="1" Margin="24" Padding="30"
                                 Background="{DynamicResource GlassSurfaceStrongBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 步骤指示器 -->
                    <StackPanel x:Name="DotsPanel" Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <!-- 内容区 -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="StepIcon" Width="76" Height="76"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StepTitle" FontSize="23" FontWeight="Bold"
                                   Foreground="{DynamicResource GlassTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,18,0,12"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="StepDesc" FontSize="15" LineHeight="24"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="440"/>
                    </StackPanel>

                    <!-- 上一步 / 下一步 -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PrevBtn" Grid.Column="0" HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="上一步" Width="110" Click="Prev_Click"/>
                        <Button x:Name="NextBtn" Grid.Column="1" HorizontalAlignment="Right"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="下一步" Width="124" Click="Next_Click"/>
                    </Grid>

                    <!-- 跳过 -->
                    <Button Grid.Row="3" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            FontSize="12"
                            Foreground="{DynamicResource GlassTextSecondaryBrush}"
                            Content="跳过引导" Click="Skip_Click"/>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Border>
</Window>
