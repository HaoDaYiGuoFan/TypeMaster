[Bb]in/
[Oo]bj/
build_temp/
publish/
publish2/
*.user
*.suo
*.userosscache
*.sln.docstates

# ============================================================
#  发布包与临时目录
#
#  dist/ 中的 zip 含 175MB 的 exe，超过 GitHub 单文件 100MB 限制，
#  只能作为 Release 附件上传，因此不进版本库。
#
#  TypeMaster-Portable-*/ 是历史便携版目录，内含 172MB 的 exe，
#  同样超过限制，必须排除（否则 push 会被 GitHub 拒绝）。
# ============================================================
dist/
.tmp/
.vs/
TypeMaster-Portable-*/

# 本地渲染验证与调试产物
*.log
_render_probe/

# ============================================================
#  用户数据（这些文件位于 %LOCALAPPDATA%\TypeMaster，
#  不应出现在项目目录，此处仅作兜底）
# ============================================================
typemaster.db
typemaster.db-shm
typemaster.db-wal
user_profile.json
custom_articles.json
course_progress.json

# ============================================================
#  操作系统
# ============================================================
Thumbs.db
desktop.ini
.DS_Store

# ============================================================
#  IDE
# ============================================================
.idea/
*.swp
*~
