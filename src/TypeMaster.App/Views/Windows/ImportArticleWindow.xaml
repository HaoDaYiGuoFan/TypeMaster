<Window x:Class="TypeMaster.App.Views.Windows.ImportArticleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:glass="clr-namespace:TypeMaster.App"
        xmlns:uc="clr-namespace:TypeMaster.App.Views.UserControls"
        mc:Ignorable="d"
        Title="导入自定义文章" Width="580" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        glass:GlassWindowBehavior.Enable="True"
        FontFamily="{DynamicResource AppFontFamily}">
    <!-- 玻璃窗体主体：圆角 + 半透明渐变 + 高光描边 -->
    <Border CornerRadius="14" Background="{DynamicResource GlassWindowBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- 玻璃标题栏 -->
                <RowDefinition Height="*"/>    <!-- 内容 -->
            </Grid.RowDefinitions>

            <uc:GlassTitleBar Grid.Row="0" Title="导入自定义文章" IconKind="FileDocument"/>

            <materialDesign:Card Grid.Row="1" Margin="16" Padding="16"
                                 Background="{DynamicResource GlassSurfaceStrongBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="文章标题：" VerticalAlignment="Center"
                                   Foreground="{DynamicResource GlassTextBrush}"/>
                        <TextBox x:Name="TitleBox" Width="300" Margin="8,0,0,0"
                                 materialDesign:HintAssist.Hint="可留空，自动取首行或默认名"/>
                        <Button Margin="12,0,0,0" Content="从文件导入" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="PickFile"/>
                    </StackPanel>

                    <TextBox Grid.Row="1" x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,4,0,8"
                             materialDesign:HintAssist.Hint="在此粘贴或输入文章正文（中英文均可，长短随意）"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource MaterialDesignFlatButton}" Click="Cancel"/>
                        <Button Content="确定导入" Margin="8,0,0,0" Click="Ok"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Border>
</Window>
